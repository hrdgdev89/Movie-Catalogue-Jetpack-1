<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Shimmer View -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:background="@color/card_background" />

            <View
                android:layout_width="220dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:background="@color/card_background" />

            <View
                android:layout_width="160dp"
                android:layout_height="16dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@color/card_background" />

            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_margin="20dp"
                android:background="@color/card_background" />

        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- Main Content Scroll -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Backdrop and Trailer Play Action -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="380dp">

                <ImageView
                    android:id="@+id/iv_backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:ignore="ContentDescription"
                    tools:src="@drawable/ic_launcher_background" />

                <!-- Gradient Fade to Bottom -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_detail_gradient" />

                <!-- Watch Trailer Center Action -->
                <LinearLayout
                    android:id="@+id/btn_watch_trailer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_play_circle">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:layout_marginStart="2dp"
                            android:src="@drawable/ic_play_arrow_24dp"
                            app:tint="@android:color/white"
                            tools:ignore="ContentDescription" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:shadowColor="#CC000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="4"
                        android:text="@string/watch_trailer"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Hidden Poster image for Glide binding / fallback -->
                <ImageView
                    android:id="@+id/iv_poster"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />

            </FrameLayout>

            <!-- Movie Info Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-24dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <!-- Movie Title -->
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:textColor="@color/text_color_light"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="Pabrik Gula" />

                <TextView
                    android:id="@+id/tv_tagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAlignment="center"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:visibility="gone"
                    tools:text="Part of the journey is the end." />

                <!-- Meta subtitle: Year | Genres | Runtime -->
                <TextView
                    android:id="@+id/tv_meta_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAlignment="center"
                    android:textColor="@color/text_color_secondary"
                    android:textSize="13sp"
                    tools:text="2025 | Horror, Mystery | 1h 50m" />

                <!-- Backwards-compatible separate fields if needed -->
                <TextView
                    android:id="@+id/tv_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_release_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_runtime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_genres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- Star Rating Row (5 stars in gold) -->
                <LinearLayout
                    android:id="@+id/layout_detail_stars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/star_1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/baseline_star_24"
                        app:tint="@color/colorGold"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/star_2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="3dp"
                        android:src="@drawable/baseline_star_24"
                        app:tint="@color/colorGold"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/star_3"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="3dp"
                        android:src="@drawable/baseline_star_24"
                        app:tint="@color/colorGold"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/star_4"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="3dp"
                        android:src="@drawable/baseline_star_24"
                        app:tint="@color/colorGold"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/star_5"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="3dp"
                        android:src="@drawable/baseline_star_24"
                        app:tint="@color/colorGold"
                        tools:ignore="ContentDescription" />

                </LinearLayout>

            </LinearLayout>

            <!-- YouTube Trailer Section -->
            <TextView
                android:id="@+id/tv_trailer_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:text="@string/title_trailer"
                android:textColor="@color/text_color_light"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_youtube_player"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="210dp">

                        <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                            android:id="@+id/youtube_player_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:enableAutomaticInitialization="false"
                            app:autoPlay="false" />

                        <!-- Thumbnail Preview Overlay before video plays -->
                        <FrameLayout
                            android:id="@+id/layout_trailer_preview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <ImageView
                                android:id="@+id/iv_trailer_poster"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                tools:ignore="ContentDescription" />

                            <!-- Gradient / Dim overlay -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#66000000" />

                            <!-- Play Button in center -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:background="@drawable/bg_play_circle"
                                    android:padding="16dp"
                                    android:src="@drawable/ic_play_arrow_24dp"
                                    app:tint="@android:color/white"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Putar Trailer"
                                    android:textColor="@color/text_color_light"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </FrameLayout>

                        <!-- Buffering / Loading Spinner -->
                        <ProgressBar
                            android:id="@+id/pb_trailer_loading"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/colorPrimary"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_no_trailer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:padding="24dp"
                            android:text="Trailer tidak tersedia untuk film ini."
                            android:textColor="@color/text_color_secondary"
                            android:visibility="gone" />

                    </FrameLayout>

                    <!-- Notice if playback restricted -->
                    <TextView
                        android:id="@+id/tv_trailer_notice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="6dp"
                        android:textColor="#FF6B6B"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="Video dibatasi oleh uploader" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_youtube"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginVertical="10dp"
                        android:backgroundTint="#C4302B"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Buka di Aplikasi YouTube"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_open_in_new_24dp"
                        app:iconGravity="textStart"
                        app:iconSize="16dp"
                        app:iconTint="@android:color/white" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Story Line Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:text="@string/story_line"
                android:textColor="@color/text_color_light"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/text_color_secondary"
                android:textSize="14sp"
                tools:text="Seorang jurnalis muda menyelidiki misteri di balik pabrik gula tua yang ditinggalkan..." />

            <!-- User Reviews Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="28dp"
                android:text="@string/title_reviews"
                android:textColor="@color/text_color_light"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_no_reviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:padding="24dp"
                android:text="Belum ada ulasan untuk film ini."
                android:textColor="@color/text_color_secondary"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_reviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_review" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Top Floating Navigation: Back button & Favorite button -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp">

        <FrameLayout
            android:id="@+id/btn_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circle_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back_24dp"
                app:tint="@android:color/white"
                tools:ignore="ContentDescription" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_favorite_container"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circle_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btn_favorite"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_favorite_border_black_24dp"
                app:tint="@android:color/white"
                tools:ignore="ContentDescription" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Error Layout -->
    <LinearLayout
        android:id="@+id/layout_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textColor="@color/text_color_light"
            android:textSize="16sp"
            tools:text="Gagal memuat detail film" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/colorPrimary"
            android:text="@string/btn_retry"
            android:textColor="@android:color/white" />

    </LinearLayout>

</FrameLayout>
